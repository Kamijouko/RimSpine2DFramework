<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<RimSpine2DFramework.DynamicPawnStateMachineDef>
		<defName>Originium_Slug_State_Machine</defName>
		<targetDynamicObject>Originium_Slug</targetDynamicObject>
		<defaultStateId>idle</defaultStateId>
		<priority>0</priority>
		<skeleton>
			<defaultSkin>default</defaultSkin>
			<scale>(2, 2)</scale>
			<offset>(0, -0.2)</offset>
			<rotation>(0, 0, 0)</rotation>
			<cameraDistance>0</cameraDistance>
		</skeleton>
		<hideVanillaPawn>true</hideVanillaPawn>
		<binding>
			<pawnKinds>
				<li>Originium_Slug</li>
			</pawnKinds>
			<factions></factions>
			<colonistOnly>false</colonistOnly>
			<allowAnimals>true</allowAnimals>
			<allowNonHumanlike>true</allowNonHumanlike>
			<allowNonPlayer>true</allowNonPlayer>
		</binding>
		<states>
			<li>
				<stateId>idle</stateId>
				<animationName>Idle</animationName>
				<loop>true</loop>
				<trackIndex>0</trackIndex>
				<useQueue>true</useQueue>
				<delay>0</delay>
				<mixDuration>0</mixDuration>
				<clearMixDuration>0.2</clearMixDuration>
				<forceRestart>false</forceRestart>
				<isFallback>true</isFallback>
				<priority>1</priority>
			</li>
			<li>
				<stateId>move</stateId>
				<animationName>Move_Loop</animationName>
				<loop>true</loop>
				<trackIndex>0</trackIndex>
				<useQueue>true</useQueue>
				<delay>0</delay>
				<clearTrack>true</clearTrack>
				<clearMixDuration>0.2</clearMixDuration>
				<forceRestart>false</forceRestart>
				<isFallback>false</isFallback>
				<priority>2</priority>
				<triggers>
					<li>
						<source>Movement</source>
						<isMoving>true</isMoving>
					</li>
				</triggers>
			</li>
			<li>
				<stateId>attack</stateId>
				<animationName>Attack</animationName>
				<loop>false</loop>
				<verbEventName>OnAttack</verbEventName>
				<trackIndex>1</trackIndex>
				<useQueue>false</useQueue>
				<delay>0</delay>
				<mixDuration>0</mixDuration>
				<clearTrack>true</clearTrack>
				<clearMixDuration>0.2</clearMixDuration>
				<forceRestart>false</forceRestart>
				<isFallback>false</isFallback>
				<priority>3</priority>
				<triggers>
					<li>
						<source>Verb</source>
						<defName>Verb_MeleeAttackDamage</defName>
					</li>
				</triggers>
			</li>
			<li>
				<stateId>death</stateId>
				<animationName>Die</animationName>
				<loop>false</loop>
				<holdPoseOnComplete>true</holdPoseOnComplete>
				<trackIndex>0</trackIndex>
				<useQueue>false</useQueue>
				<clearTrack>true</clearTrack>
				<clearMixDuration>0.2</clearMixDuration>
				<forceRestart>false</forceRestart>
				<isFallback>false</isFallback>
				<priority>4</priority>
				<triggers>
					<li>
						<source>LifeState</source>
						<isDead>true</isDead>
					</li>
				</triggers>
			</li>
			<!--
			<li>
				<stateId></stateId>
				<animationName></animationName>
				<loop></loop>
				<useQueue></useQueue>
				<trackIndex></trackIndex>
				<mixDuration></mixDuration>
				<delay></delay>
				<clearTrack></clearTrack>
				<clearMixDuration></clearMixDuration>
				<forceRestart></forceRestart>
				<isFallback></isFallback>
				<priority></priority>
				<triggers>
					<li>
						<source></source>
						<isMoving></isMoving>
						<def></def>
						<defName></defName>
						<stageIndex></stageIndex>
						<stageName></stageName>
						<threshold></threshold>
						<thresholdGreaterOrEqual></thresholdGreaterOrEqual>
					</li>
				</triggers>
			</li>
			-->
		</states>
		
	</RimSpine2DFramework.DynamicPawnStateMachineDef>
</Defs>